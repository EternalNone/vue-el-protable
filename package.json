{
  "name": "vue-el-protable",
  "version": "0.1.1",
  "description": "基于 Element Plus 的配置驱动表格组件：一份 columns 配置生成筛选表单 + 表格 + 分页 + 数据请求",
  "keywords": [
    "vue",
    "element-plus",
    "table",
    "pro-table",
    "config-driven"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite playground --config vite.config.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "element-plus": ">=2.9.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@element-plus/icons-vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.14.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "expect-type": "^1.2.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.0"
  }
}
